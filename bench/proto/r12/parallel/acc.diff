index e13578d..4a02def 100644
--- a/bench/proto/r12/parallel/pkg_thr/src/lmm.cpp
+++ b/bench/proto/r12/parallel/pkg_acc/src/lmm.cpp
@@ -777,3 +777,22 @@ extern "C" SEXP suez_eigen_sym(SEXP A) {
                             Rcpp::Named("vectors") = MatrixXd(es.eigenvectors().rowwise().reverse()));
   END_RCPP
 }
+
+// Symmetric eigen-decomposition by Apple Accelerate's LAPACK dsyevd (macOS; R's own LAPACK is the reference one
+// there): 6-7x faster than Eigen's solver at N = 2000, ~2-3x at N = 4000 (bench/proto/r12/parallel/eig_accel.R).
+#ifdef __APPLE__
+extern "C" void dsyevd_(const char*, const char*, const int*, double*, const int*, double*, double*, const int*, int*, const int*, int*);
+extern "C" SEXP suez_eigen_accelerate(SEXP A) {
+  BEGIN_RCPP
+  Rcpp::NumericMatrix M(A); const int n = M.nrow(); MatrixXd V = Eigen::Map<MatrixXd>(M.begin(), n, n); VectorXd w(n);
+  int info = 0, lwork = -1, liwork = -1, iw = 0; double wk = 0;
+  dsyevd_("V", "L", &n, V.data(), &n, w.data(), &wk, &lwork, &iw, &liwork, &info);
+  lwork = (int)wk; liwork = iw; std::vector<double> work(std::max(1, lwork)); std::vector<int> iwork(std::max(1, liwork));
+  dsyevd_("V", "L", &n, V.data(), &n, w.data(), work.data(), &lwork, iwork.data(), &liwork, &info);
+  if (info != 0) Rcpp::stop("symmetric eigen-decomposition failed (dsyevd info %d)", info);
+  return Rcpp::List::create(Rcpp::Named("values") = VectorXd(w.reverse()), Rcpp::Named("vectors") = MatrixXd(V.rowwise().reverse()));
+  END_RCPP
+}
+#else
+extern "C" SEXP suez_eigen_accelerate(SEXP A) { Rf_error("Accelerate is only available on macOS"); return R_NilValue; }
+#endif
