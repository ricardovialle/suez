+// Raw rotations of individual-level genotypes: W[[k]] (individuals x N-1) = rowsum(U * c_k, individual), Gi
+// (individuals x SNPs). Returns the list of W[[k]]' Gi, computed block by block (bs: block sizes): blocks are fixed
+// runs of 64 consecutive SNPs (see map_interaction_qtl), so a SNP's column is always the same product,
+// whatever the chunk of genes it is rotated for.
+extern "C" SEXP suez_rotate_ind(SEXP W, SEXP Gi, SEXP bs) {
+  BEGIN_RCPP
+  Rcpp::List w(W); Rcpp::IntegerVector b(bs); const Eigen::Map<MatrixXd> g = Rcpp::as<Eigen::Map<MatrixXd>>(Gi); Rcpp::List out(w.size());
+  for (int k = 0; k < w.size(); ++k) {
+    const Eigen::Map<MatrixXd> wk = Rcpp::as<Eigen::Map<MatrixXd>>(w[k]);
+    Rcpp::NumericMatrix o(wk.cols(), g.cols()); Eigen::Map<MatrixXd> om(o.begin(), o.nrow(), o.ncol());
+    for (int i = 0, at = 0; i < b.size(); at += b[i++]) om.middleCols(at, b[i]).noalias() = wk.transpose() * g.middleCols(at, b[i]);
+    out[k] = o;
+  }
+  return out;
+  END_RCPP
